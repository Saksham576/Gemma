{
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "dev:api:reload": "cd backend && uvicorn app.main:app --reload --reload-exclude '__pycache__/*' --reload-exclude '*.pyc' --host 0.0.0.0 --port 8000",
    "dev:web": "npm --prefix frontend run dev",
    "setup": "npm install && python3 -m pip install -r backend/requirements.txt && cd frontend && npm install",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
